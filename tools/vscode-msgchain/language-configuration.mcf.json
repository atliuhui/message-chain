{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"]
  ],
  "colorizedBracketPairs": [
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": " }}" },
    { "open": "{%", "close": " %}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^#{3,}",
      "end": "^(?=#{3,})"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_-]*"
}
