{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Command Execution Protocol",
  "scopeName": "source.cep",
  "fileTypes": ["cep"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#request-line" },
    { "include": "#response-line" },
    { "include": "#header-line" },
    { "include": "#named-argument" },
    { "include": "#token-argument" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.cep"
    },
    "request-line": {
      "match": "^\\s*(EXEC)\\s+((?:\\{\\{[^}]*\\}\\}|\\S)+)\\s+(CEP)(/)([0-9]+\\.[0-9]+)\\s*$",
      "name": "meta.request.start-line.cep",
      "captures": {
        "1": { "name": "keyword.control.verb.cep" },
        "2": { "name": "entity.name.function.command.cep" },
        "3": { "name": "constant.language.protocol.cep" },
        "4": { "name": "constant.language.protocol.cep" },
        "5": { "name": "constant.numeric.protocol-version.cep" }
      }
    },
    "response-line": {
      "match": "^\\s*(CEP)(/)([0-9]+\\.[0-9]+)\\s+([0-9]+)\\s+(\\S.*)$",
      "name": "meta.response.status-line.cep",
      "captures": {
        "1": { "name": "constant.language.protocol.cep" },
        "2": { "name": "constant.language.protocol.cep" },
        "3": { "name": "constant.numeric.protocol-version.cep" },
        "4": { "name": "constant.numeric.exit-code.cep" },
        "5": { "name": "string.unquoted.reason.cep" }
      }
    },
    "header-line": {
      "match": "^([A-Za-z][A-Za-z0-9_-]*)\\s*(:)\\s*(.*)$",
      "name": "meta.message.header.line.cep",
      "captures": {
        "1": { "name": "entity.name.tag.header.cep" },
        "2": { "name": "punctuation.separator.key-value.cep" },
        "3": {
          "name": "string.unquoted.header-value.cep",
          "patterns": [{ "include": "#placeholder" }]
        }
      }
    },
    "named-argument": {
      "match": "^\\s*(-{1,2}[A-Za-z][A-Za-z0-9_:.-]*)\\s+(\\S.*)$",
      "name": "meta.request.argument.named.cep",
      "captures": {
        "1": { "name": "variable.parameter.function.argument-name.cep" },
        "2": {
          "name": "string.unquoted.argument-value.cep",
          "patterns": [{ "include": "#placeholder" }]
        }
      }
    },
    "token-argument": {
      "match": "^\\s*(\\S.*)$",
      "name": "meta.request.argument.token.cep",
      "captures": {
        "1": {
          "name": "string.unquoted.argument-token.cep",
          "patterns": [{ "include": "#placeholder" }]
        }
      }
    },
    "placeholder": {
      "match": "(\\$\\{)([A-Za-z_][A-Za-z0-9_]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.section.embedded.begin.cep" },
        "2": { "name": "variable.other.environment.cep" },
        "3": { "name": "punctuation.section.embedded.end.cep" }
      }
    }
  }
}
