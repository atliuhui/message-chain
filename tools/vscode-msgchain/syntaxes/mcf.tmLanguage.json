{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Message Chain Format",
  "scopeName": "source.mcf",
  "fileTypes": ["mcf"],
  "tokenTypes": {
    "string.unquoted.metadata-value.mcf": "other",
    "string.unquoted.variable-value.mcf": "other",
    "string.unquoted.header-value.mcf": "other",
    "string.unquoted.url.mcf": "other"
  },
  "patterns": [
    { "include": "#separator" },
    { "include": "#horizontal-rule" },
    { "include": "#step-metadata" },
    { "include": "#variable" },
    { "include": "#comment" },
    { "include": "#request-line" },
    { "include": "#cep-line" },
    { "include": "#header-line" },
    { "include": "#liquid" }
  ],
  "repository": {
    "separator": {
      "match": "^(#{3,})\\s*(.*)$",
      "name": "markup.heading.step-separator.mcf",
      "captures": {
        "1": { "name": "punctuation.definition.heading.mcf" },
        "2": { "name": "entity.name.section.step-title.mcf" }
      }
    },
    "horizontal-rule": {
      "match": "^\\s*([-=]{3,}|\\*{3,})\\s*$",
      "name": "meta.separator.step.mcf"
    },
    "step-metadata": {
      "match": "^\\s*(#)\\s*(@)(name|kind|when|timeout|retry-attempts|retry-delays|expect-codes|continue-on-error|description)\\b\\s*(.*)$",
      "name": "meta.step.metadata.line.mcf",
      "captures": {
        "1": { "name": "punctuation.definition.comment.mcf" },
        "2": { "name": "entity.name.tag.metadata.mcf" },
        "3": { "name": "entity.name.tag.metadata.mcf" },
        "4": {
          "name": "string.unquoted.metadata-value.mcf",
          "patterns": [
            { "include": "#metadata-kind-value" },
            { "include": "#metadata-bool-value" },
            { "include": "#liquid" }
          ]
        }
      }
    },
    "metadata-kind-value": {
      "match": "\\b(http|cep|empty)\\b",
      "name": "constant.language.step-kind.mcf"
    },
    "metadata-bool-value": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.mcf"
    },
    "variable": {
      "match": "^\\s*(@)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(.*)$",
      "name": "meta.definition.variable.mcf",
      "captures": {
        "1": { "name": "meta.definition.variable.mcf" },
        "2": { "name": "meta.definition.variable.mcf" },
        "3": { "name": "keyword.operator.assignment.mcf" },
        "4": {
          "name": "string.unquoted.variable-value.mcf",
          "patterns": [{ "include": "#liquid" }]
        }
      }
    },
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.mcf"
    },
    "request-line": {
      "match": "^\\s*(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|TRACE|CONNECT)\\s+((?:\\{\\{[^}]*\\}\\}|\\S)+)(?:\\s+(HTTP/[0-9.]+))?\\s*$",
      "name": "meta.exchange.request.line.http.mcf",
      "captures": {
        "1": { "name": "keyword.control.http.method.mcf" },
        "2": {
          "name": "string.unquoted.url.mcf",
          "patterns": [{ "include": "#liquid" }]
        },
        "3": { "name": "constant.language.http.version.mcf" }
      }
    },
    "cep-line": {
      "match": "^\\s*(EXEC|SHELL|RUN|CALL)\\s+((?:\\{\\{[^}]*\\}\\}|\\S)+)(?:\\s+(CEP/[0-9.]+))?\\s*$",
      "name": "meta.exchange.request.line.cep.mcf",
      "captures": {
        "1": { "name": "keyword.control.cep.verb.mcf" },
        "2": {
          "name": "entity.name.function.command.mcf",
          "patterns": [{ "include": "#liquid" }]
        },
        "3": { "name": "constant.language.cep.version.mcf" }
      }
    },
    "header-line": {
      "match": "^([A-Za-z][A-Za-z0-9-]*)\\s*(:)\\s*(.*)$",
      "name": "meta.exchange.header.line.mcf",
      "captures": {
        "1": { "name": "entity.name.tag.header.mcf" },
        "2": { "name": "punctuation.separator.key-value.mcf" },
        "3": {
          "name": "string.unquoted.header-value.mcf",
          "patterns": [{ "include": "#liquid" }]
        }
      }
    },
    "liquid": {
      "patterns": [
        { "include": "source.liquid" }
      ]
    }
  }
}
